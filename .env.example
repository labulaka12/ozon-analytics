# Ozon Analytics 环境配置
# 复制此文件为 .env 并填入真实值

# API 密钥加密密钥（生产环境必须设置，否则自动生成临时密钥）
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生产环境（Render）需在 render.yaml 中设置此环境变量
OZON_ENCRYPTION_KEY=

# CORS 允许的前端源（逗号分隔，留空则默认仅允许本地访问）
# 生产环境建议设置为 "*" 或具体的 Render 域名
CORS_ORIGINS=http://localhost:8848,http://127.0.0.1:8848

# 代理设置（可选，访问 Ozon API 使用的 HTTP/HTTPS 代理）
# 如果你在国内需要通过代理访问 api-seller.ozon.ru，填写代理地址
# 留空则直连（禁用系统代理）
# OZON_PROXY_URL=http://127.0.0.1:7890

# 数据库连接（生产环境 Render 会自动注入 PostgreSQL DATABASE_URL）
# 开发环境默认使用 data/ozon_analytics.db（SQLite）
# DATABASE_URL=postgresql://user:password@host:5432/ozon_analytics

# 服务端口（生产环境 Render 会注入 PORT 环境变量）
SERVER_PORT=8848
