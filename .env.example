# ============================================================
# Ozon Analytics — 生产环境配置模板
# 复制此文件为 .env 并填入真实值: cp .env.example .env
# ============================================================

# ==================== 基础配置（必填） ====================

# 运行环境（生产环境必须设为 production）
ENV=production

# 数据库连接（PostgreSQL，生产环境必填）
# 格式: postgresql://用户名:密码@主机:端口/数据库名
# 安装脚本会自动生成，如果手动填写请替换下面的占位符
DATABASE_URL=postgresql://ozon:YOUR_DB_PASSWORD@localhost:5432/ozon_analytics

# API 密钥加密密钥（必填！用于加密存储 Ozon API Key）
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OZON_ENCRYPTION_KEY=

# JWT 密钥（必填！用于用户认证 Token 签名）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
OZON_JWT_SECRET=

# ==================== 网络配置（必填） ====================

# CORS 允许的前端源（逗号分隔，必须包含你的服务器 IP）
# 示例: CORS_ORIGINS=http://1.2.3.4,http://1.2.3.4:80
CORS_ORIGINS=http://YOUR_SERVER_IP

# 前端 URL（用于邮件中的链接、密码重置等）
FRONTEND_URL=http://YOUR_SERVER_IP

# 代理设置（可选，中国服务器访问俄罗斯 Ozon API 可能需要）
# OZON_PROXY_URL=http://127.0.0.1:7890

# ==================== JWT ====================

# JWT Token 有效期（分钟，默认 1440 = 24小时）
OZON_JWT_EXPIRE_MINUTES=1440

# ==================== 限流 ====================

# 速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# ==================== Redis（可选） ====================

# Redis 连接（用于缓存 + 限流共享，不配则使用内存存储）
# REDIS_URL=redis://localhost:6379/0

# ==================== Stripe 支付（可选） ====================

# Stripe 密钥（测试环境用 sk_test_xxx，生产环境用 sk_live_xxx）
# STRIPE_SECRET_KEY=

# Stripe Webhook 签名密钥
# STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs（在 Stripe Dashboard 创建产品后获取）
# STRIPE_PRO_PRICE_ID=
# STRIPE_ENTERPRISE_PRICE_ID=

# ==================== 邮件 SMTP（可选） ====================

# SMTP 服务器配置（用于密码重置、告警通知等）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@your-domain.com
# SMTP_USE_TLS=true

# ==================== SaaS 配置 ====================

# 试用天数
TRIAL_DAYS=14
